// Hand-written fixture for the science ledger. The structure follows the PARAMETERS node
// and the ResearchAndDevelopment scenario of a career save of game version 1.12.5. The
// values are invented, and so is the form of the asteroid sample's identifier.
GAME
{
	version = 1.12.5
	PARAMETERS
	{
		CAREER
		{
			ScienceGainMultiplier = 0.6
		}
	}
	SCENARIO
	{
		name = ResearchAndDevelopment
		sci = 12.5
		Science
		{
			id = crewReport@KerbinSrfLandedLaunchPad
			title = Crew Report while on the launch pad
			dsc = 1
			scv = 0.4
			sbv = 0.300000012
			sci = 0.9
			asc = True
			cap = 1.5
		}
		Science
		{
			id = temperatureScan@KerbinFlyingHigh
			title = Temperature Scan while flying high over Kerbin
			dsc = 1
			scv = 0
			sbv = 0.899999976
			sci = 7.19999981
			asc = True
			cap = 7.19999981
		}
		Science
		{
			id = mysteryGoo@MunInSpaceLow
			title = Mystery Goo Observation while in space near the Mun
			dsc = 1
			scv = 0.6
			sbv = 3
			sci = 20
			asc = True
			cap = 50
		}
		Science
		{
			id = barometerScan@KerbinFlyingLow
			title = Atmospheric Pressure Scan while flying over Kerbin
			dsc = 1
			scv = 0
			sbv = 0.75
			sci = 9
			asc = True
			cap = 9
		}
		Science
		{
			id = asteroidSample@KerbinInSpaceLow_PotatoroidAAA-001
			title = Sample of an invented asteroid
			dsc = 1
			scv = 0.5
			sbv = 1
			sci = 30
			asc = True
			cap = 42
		}
		Science
		{
			id = recovery@KerbinFlew
			title = Recovery of a vessel returned from a flight over Kerbin
			dsc = 1
			scv = 0
			sbv = 5
			sci = 6
			asc = True
			cap = 6
		}
		Science
		{
			id = crewReport@KerbinSrfLandedLaunchPad
			title = A repeat of the first subject
			dsc = 1
			scv = 0
			sbv = 0.300000012
			sci = 1.5
			asc = True
			cap = 1.5
		}
		Science
		{
			id = crewreport@KerbinSrfLandedLaunchPad
			title = The first subject with a lower case letter
			dsc = 1
			scv = 0
			sbv = 0.300000012
			sci = 0.25
			asc = True
			cap = 1.5
		}
		Science
		{
			id = crewReport@KerbinSrfLanded<unnamedlocation1>
			title = A placeholder identifier, which no game save holds
			dsc = 1
			scv = 0
			sbv = 0.300000012
			sci = 0.5
			asc = True
			cap = 1.5
		}
	}
