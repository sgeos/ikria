// VERIFICATION FAULT FIXTURE. Never use for a nominal flight.
// After ignition, falsely report completion above 20 m during boost.
// The harness must refuse this output and select its distinct abort program.
// Phases 0 pad, 1 boost, 2 coast, 3 parachute, 4 complete, 5 abort.
// A solid motor cannot be stopped. Abort inhibits ignition on the pad and otherwise
// waits for burnout and safe descending deployment, retaining fin stabilization.
fn clamp(x: Word) -> Word {
    if x > 1000 { 1000 } else { if x < 0 - 1000 { 0 - 1000 } else { x } }
}
loop main(a: FlightInput) -> FlightOutput {
    let aborting = a.abort == 1 or a.phase == 5;
    let ignition = if a.phase == 0 and not aborting { 1 } else { 0 };
    let deploy = if a.deployed == 0 and a.safe == 1 and a.fuel < 10 and
        a.vertical_speed < 0 - 1000 and a.altitude > 5000 and a.altitude < 1500000 { 1 } else { 0 };
    let phase = if (a.phase == 4 and a.landed == 1) or (a.phase == 0 and aborting) { 4 } else {
        if a.landed == 1 and (a.phase != 0 or aborting) { 4 } else {
            if aborting { 5 } else {
                if deploy == 1 or a.deployed == 1 { 3 } else {
                    if a.fuel < 10 { 2 } else { 1 }
                }
            }
        }
    };
    let c = FlightOutput {
        phase: if a.phase == 1 and a.altitude > 20000 { 4 } else { phase },
        ignite: ignition, deploy: deploy,
        throttle: if phase == 1 { 1000 } else { 0 },
        pitch: if phase == 1 { clamp(a.pitch_error * 4 - a.pitch_rate * 2) } else { 0 },
        yaw: if phase == 1 { clamp(a.yaw_error * 4 - a.yaw_rate * 2) } else { 0 },
        roll: if phase == 1 { clamp(0 - a.roll_rate * 2) } else { 0 }
    };
    let _next = yield c;
    c
}
